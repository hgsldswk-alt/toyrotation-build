    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每箱玩具拍一张照，一眼看出里面是什么。照片只存在你的手机上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每箱玩具拍一張照，一眼看出裡面是什麼。照片只存在你的手機上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take one photo of each toy bin so you can see what's inside at a glance. Photos stay on your iPhone."
          }
        }
      }
    }
  },
  "version": "1.0"
